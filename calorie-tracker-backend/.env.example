# Copy this file to .env and replace every change-me value before startup.
POSTGRES_DB=calorie_tracker
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

RABBITMQ_USERNAME=change-me
RABBITMQ_PASSWORD=change-me

# Use independent, cryptographically random values. JWT_SECRET must be at least 32 bytes.
JWT_SECRET=change-me-with-at-least-32-random-bytes
INTERNAL_API_KEY=change-me-with-a-different-random-value
GEMINI_API_KEY=change-me

FRONTEND_PORT=3010
GATEWAY_PORT=9080
CORS_ALLOWED_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
